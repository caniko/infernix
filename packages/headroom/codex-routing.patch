+def connect_guarded_websocket(
+    url: str, *, upstream_base_url: str | None = None, attempt: int = 0, **kwargs: Any
+) -> Any:
+    """Carry validated addresses to WS without changing Host or TLS SNI."""
+    from websockets.asyncio.client import connect
+    from websockets.proxy import get_proxy
+    from websockets.uri import parse_uri
+
+    if upstream_base_url is None:
+        return connect(url, **kwargs)
+
+    class NoRedirectConnect(connect):
+        def process_redirect(self, exc: Exception) -> Exception:
+            return exc
+
+    uri = parse_uri(url)
+    pin = guarded_pin(uri.host)
+    if pin is not None:
+        if pin.is_expired():
+            raise _refusal(uri.host, "the validated addresses have expired")
+        if get_proxy(uri) is not None:
+            if not proxied_upstream_listed(httpx.URL(upstream_base_url)):
+                raise _refusal(uri.host, "the WebSocket proxy cannot enforce address pinning")
+        else:
+            kwargs.update(host=pin.addresses[attempt % len(pin.addresses)], proxy=None)
+    return NoRedirectConnect(url, **kwargs)


